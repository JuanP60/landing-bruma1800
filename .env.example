# URL del webhook de n8n que atiende el chatbot (ver src/app/api/chat/route.ts).
# El workflow debe exponer un nodo Webhook (POST) que reciba
#   { message, sessionId, history, source }
# y devuelva
#   { reply: string }
#
# Sin esta variable, /api/chat sigue funcionando: responde con un mensaje de
# respaldo en vez de fallar, así ChatbotWidget nunca se rompe.
N8N_WEBHOOK_URL=
